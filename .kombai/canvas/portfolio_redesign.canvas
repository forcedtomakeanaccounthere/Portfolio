-full md:w-2/3\" data-kid=\"15\">\n          <p class=\"text-[1.8rem] font-light leading-[1.8] tracking-[0.05rem] text-black\" data-kid=\"16\">\n            Next.js, React.js, Node.js, Express, Redux, GraphQL, Tailwind CSS, HTML, MongoDB\n          </p>\n        </div>\n      </div>\n\n      \n      <div class=\"group flex flex-col md:flex-row border-b border-[#E5E5E5] py-8 px-4 transition-all duration-300 hover:border-l-[3px] hover:border-l-[#DC143C] hover:bg-gray-50/50\" data-kid=\"17\">\n        <div class=\"w-full md:w-1/3 mb-2 md:mb-0\" data-kid=\"18\">\n          <h2 class=\"text-[1.4rem] font-bold uppercase tracking-[0.1rem] text-black group-hover:text-[#DC143C] transition-colors duration-300\" data-kid=\"19\">\n            AI/ML & Research\n          </h2>\n        </div>\n        <div class=\"w-full md:w-2/3\" data-kid=\"20\">\n          <p class=\"text-[1.8rem] font-light leading-[1.8] tracking-[0.05rem] text-black\" data-kid=\"21\">\n            Machine Learning, Deep Learning, TensorFlow, NumPy, Pandas, Scikit-learn\n          </p>\n        </div>\n      </div>\n\n      \n      <div class=\"group flex flex-col md:flex-row border-b border-[#E5E5E5] py-8 px-4 transition-all duration-300 hover:border-l-[3px] hover:border-l-[#DC143C] hover:bg-gray-50/50\" data-kid=\"22\">\n        <div class=\"w-full md:w-1/3 mb-2 md:mb-0\" data-kid=\"23\">\n          <h2 class=\"text-[1.4rem] font-bold uppercase tracking-[0.1rem] text-black group-hover:text-[#DC143C] transition-colors duration-300\" data-kid=\"24\">\n            Cloud & DevOps\n          </h2>\n        </div>\n        <div class=\"w-full md:w-2/3\" data-kid=\"25\">\n          <p class=\"text-[1.8rem] font-light leading-[1.8] tracking-[0.05rem] text-black\" data-kid=\"26\">\n            AWS, Google Cloud, Docker, Git, GitHub, Linux\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
